# -*- mode: Perl -*-
# =============================================================================
# pensee.cls.ltxml — LaTeXML binding for the pensee document class
#
# LaTeXML uses this file instead of parsing pensee.cls directly.
# It delegates all article-class behaviour to LaTeXML's built-in
# article binding, then adds definitions for pensee-specific commands.
#
# Placed alongside pensee.cls in latex-src/classes/.
# The conversion script passes --path=../classes so latexml finds both.
# =============================================================================
use strict;
package LaTeXML::Package::Pool;
use LaTeXML::Package;

# -----------------------------------------------------------------------------
# Delegate to the article class binding — LaTeXML's article support is
# complete and battle-tested; no need to reimplement it here.
# -----------------------------------------------------------------------------
LoadClass('article');

# -----------------------------------------------------------------------------
# Bundled packages declared in pensee.cls
# LaTeXML has built-in bindings for all of these.
# -----------------------------------------------------------------------------
RequirePackage('amsmath');
RequirePackage('amssymb');
RequirePackage('amsthm');
RequirePackage('graphicx');
RequirePackage('float');
RequirePackage('xcolor');
RequirePackage('hyperref');
RequirePackage('geometry');

# Note: the duplicate title/date block that LaTeXML generates from \title{}
# and \date{} is stripped by the Python post-processor in convert-latex.sh,
# since PaperMod already renders these from the YAML front matter.

# -----------------------------------------------------------------------------
# Convenience colour commands — expand to \textcolor calls.
# LaTeXML's xcolor binding handles \textcolor natively.
# -----------------------------------------------------------------------------
DefMacro('\textred{}',   '\textcolor{red}{#1}');
DefMacro('\textblue{}',  '\textcolor{blue}{#1}');
DefMacro('\textgreen{}', '\textcolor{green}{#1}');

# -----------------------------------------------------------------------------
# \blankline — vertical whitespace.
# \vskip has no direct HTML equivalent; emit a paragraph break so browsers
# render a visible gap between surrounding content blocks.
# -----------------------------------------------------------------------------
DefMacro('\blankline', '\par ');

# -----------------------------------------------------------------------------
# \rubric{text} — lightweight standalone essay heading.
# Wraps the text in a paragraph with class "ltx_rubric" so CSS can style it
# as a block-level italic label without imposing a formal section hierarchy.
# -----------------------------------------------------------------------------
DefConstructor('\rubric{}',
  "<ltx:p class='ltx_rubric'>#1</ltx:p>");

1;
