    <item>
      <title>Reading Notes on &#34;Will 7: The Will to Express&#34; by Orin</title>
      <link>http://localhost:1313/posts/notes_orin_article_will_7/</link>
      <pubDate>Wed, 27 May 2026 00:00:00 +0000</pubDate>
      <guid>http://localhost:1313/posts/notes_orin_article_will_7/</guid>
      <description>&lt;link rel=&#34;stylesheet&#34; href=&#34;http://localhost:1313/css/LaTeXML.css&#34;&gt;
&lt;link rel=&#34;stylesheet&#34; href=&#34;http://localhost:1313/css/ltx-article.css&#34;&gt;
&lt;!-- CMU Serif: self-hosted, always current via current/ symlink --&gt;
